# 1. تحديد النسخة المستقرة من Node
FROM node:20-alpine

# 2. تحديد مكان الشغل جوا الكونتينر
WORKDIR /app

# 3. نسخ ملفات التعريف وتسطيب المكتبات
COPY package*.json ./
RUN npm install

# 4. نسخ باقي ملفات المشروع
COPY . .

# 5. فتح البورت اللي السيرفر شغال عليه (مثلاً 3000)
EXPOSE 3000

# 6. أمر التشغيل (بناءً على الصورة اللي بعتها)
CMD ["npm", "run", "dev"]